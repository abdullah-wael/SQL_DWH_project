create view gold.dim_customer as 
select
	row_number() over(order by cci.cst_id ) as customer_key ,
	cci.cst_id customer_id,
	cci.cst_key customer_number ,
	cci.cst_firstname first_name,
	cci.cst_lastname last_name ,
	case
		when cci.cst_gndr != 'n/a' then cci.cst_gndr
		else coalesce(eca.gen, 'n/a')
	end as gender
,
	cci.cst_marital_status marital_status 
,
	eca.bdate birth_date,
	ela.cntry country
from
	silver.crm_cust_info cci
left join silver.erp_cust_az12 eca on
	cci.cst_key = eca.cid
left join silver.erp_loc_a101 ela 
on
	cci.cst_key = ela.cid ;



create view gold.dim_products as 
select
    row_number()over(order by cpi.prd_start_dt) as product_key,
	cpi.prd_id product_id,
	cpi.prd_nm product_name,
	cpi.prd_key product_number,
	cpi.cat_id category_id,
	cpi.prd_cost product_cost,
	cpi.prd_line product_line,
	cpi.prd_start_dt product_start_date ,
	cat.cat category,
	cat.subcat sub_category,
	cat.maintenance
from
	silver.crm_prd_info cpi
left join silver.erp_px_cat_g1v2 cat on
	cpi.cat_id = cat.id
where
	cpi.prd_end_dt is null;



create view gold.fact_sales as 
select
	cd.sls_ord_num order_number,
	dp.product_key ,
	dc.customer_key ,
	cd.sls_order_dt order_date,
	cd.sls_ship_dt ship_date,
	cd.sls_due_dt due_date,
	cd.sls_sales sales_amount,
	cd.sls_quantity,
	cd.sls_price
from
	silver.crm_sales_details cd
left join gold.dim_customer dc 
	on
	dc.customer_id = cd.sls_cust_id
left join gold.dim_products dp 
	on
	cd.sls_prd_key = dp.product_number 

	;



